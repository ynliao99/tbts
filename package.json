{
  "name": "tbts-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/fetch-content.mjs --if-missing && vite",
    "build": "node scripts/fetch-content.mjs --if-missing && vite-ssg build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "content:fetch": "node scripts/fetch-content.mjs",
    "content:legacy": "node scripts/fetch-content.mjs --legacy"
  },
  "dependencies": {
    "@unhead/vue": "^3.4.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-ssg": "^28.3.0",
    "vue-tsc": "^3.3.13"
  }
}
